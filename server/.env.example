PORT=3000

# comma-separated list of origins allowed to call this API from the browser
# (the client PCs are on a different VLAN than this server, so this must be set)
CORS_ORIGINS=http://192.168.x.x:5500

# where the SQLite file lives (defaults to server/db/tgm.db if unset)
DB_PATH=

# root folder of the Express accounting DBF exports (same LAN as this server)
EXPRESS_DBF_ROOT=Z:\ExpressI

# Express DBF sync schedule. Default is every 15 minutes to reduce Node.js RAM pressure.
EXPRESS_SYNC_CRON=*/15 * * * *

# Google Vision API key (moved server-side — was hardcoded in index.html before)
VISION_API_KEY=

# Gemini API key (free tier, no card required — console.aistudio.google.com/apikey) for
# AI-assisted customer corporate grouping (server/routes/aiGrouping.js)
GEMINI_API_KEY=
# optional model override — defaults to gemini-3.5-flash in code
GEMINI_MODEL=

# SMTP for password-reset emails (server/lib/mailer.js) — if unset, reset links are only logged to
# the server console instead of erroring (so the team can hand them out manually while SMTP isn't
# configured yet). mail.tgm.co.th:465 is the same mail server the sibling E-Memo system uses.
SMTP_HOST=mail.tgm.co.th
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# อีเมลแจ้งอนุมัติใบเคาะราคา (lib/promoApprovalMail.js) ใช้ SMTP ชุดเดียวกับด้านบน
# APP_PUBLIC_URL = หน้าเว็บที่ปุ่ม "เปิดดูในระบบ" ในอีเมลพาไป (ค่าเริ่มต้น https://tss-supplychain.vercel.app)
# PUBLIC_API_URL = URL สาธารณะของ server นี้ สำหรับปุ่มอนุมัติ/ไม่อนุมัติในอีเมล — ว่าง = ใช้ host ที่ request
#   ส่งอนุมัติเข้ามา (เช่น tunnel) — ถ้า tunnel URL เปลี่ยน ลิงก์ในอีเมลเก่าจะใช้ไม่ได้ ควรตั้งเป็นโดเมนถาวร
APP_PUBLIC_URL=
PUBLIC_API_URL=

# tgm-wms Supabase (public URL + anon key) — ใช้ตรวจ token ผู้ใช้ tgm-wms ก่อนเขียน express_stock_snapshots
WMS_SUPABASE_URL=
WMS_SUPABASE_ANON_KEY=

# tss-wms local backend (wms/, mounted at /wms)
WMS_DB_PATH=
WMS_JWT_SECRET=
WMS_SERVICE_KEY=
# WMS_BACKUP_DIR=
# WMS_PUBLIC_URL=
